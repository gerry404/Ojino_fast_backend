# Copier en .env et ajuster. Le fichier .env n'est jamais commite.

# Port d'ecoute. 8090 pour ne pas entrer en conflit avec les services Spring
# (8081 a 8089) ni avec mongo-express.
PORT=8090

# --- Authentification -------------------------------------------------------
# IMPERATIVEMENT identique a OJINO_JWT_SECRET des services Spring : c'est ce
# partage qui permet de valider un jeton sans appeler l'auth-service.
OJINO_JWT_SECRET=dev-secret-a-remplacer-absolument-en-production-32+
OJINO_JWT_ISSUER=ojino-auth

# Secret partage des routes internes, appelees par les services Spring pour
# pousser un evenement vers les clients connectes.
OJINO_INTERNAL_TOKEN=dev-internal-token-a-remplacer-en-production

# --- Connexions -------------------------------------------------------------
# Origines autorisees a ouvrir une WebSocket. Une liste vide en production
# reviendrait a accepter n'importe quel site.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Nombre maximal de connexions simultanees par utilisateur. Sans plafond, un
# client qui boucle sur la reconnexion epuise la memoire du serveur.
MAX_CONNECTIONS_PER_USER=5
